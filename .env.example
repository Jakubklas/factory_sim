# ─────────────────────────────────────────────────────────────────────────────
# Environment variables — the single registry for both binaries.
#
# Copy to `.env` for local dev (the Justfile does `set dotenv-load`, so `just`
# recipes pick it up automatically). In the cluster these are set by the Helm
# templates / the backend's k8s reconciler instead.
#
# Source of truth in code:
#   backend   → backend/src/config_handle/app_config.rs  (AppConfig::from_env)
#   simulator → simulator/src/config.rs                  (SimConfig::from_env)
# Nothing else reads env vars directly.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────────────────────
BE_HOST=0.0.0.0                       # API/WebSocket bind host
BE_PORT=3001                          # API/WebSocket bind port
BE_TICK_MS=100                        # orchestration + stream tick period (ms)

DATABASE_URL=                         # postgres://… — unset ⇒ no persistence (reads plant.json)
SEED_DIR=                             # dir with device_types.json + plant.json + inventory.json; unset ⇒ no seeding
PLANT_CONFIG=/config                  # no-DB fallback: dir holding plant.json
ASSET_DIR=/data/assets                # local asset store root (seam; not served yet)

PKI_DIR=./pki                         # OPC-UA cert store base (shared by both binaries)
OPCUA_URI_OVERRIDE=                   # rewrite every PLC's OPC-UA host (local/remote dev); unset ⇒ use each PLC's URI

SIMULATOR_IMAGE=factory-sim/simulator:latest   # image the reconciler deploys for sim PLCs
BACKEND_SVC_URL=                      # URL sims fetch their config from; unset ⇒ http://backend:{BE_PORT}
K8S_NAMESPACE=default                 # namespace the reconciler manages

# ── Simulator (one process per simulated PLC) ────────────────────────────────
SIM_PLC_ID=                           # REQUIRED — which PLC this process owns (e.g. plc-001)
BACKEND_URL=                          # fetch config from the API; unset ⇒ read from PLANT_CONFIG files
SIM_TICK_MS=100                       # physics tick period (ms)
SIM_HEALTH_PORT=9000                  # liveness endpoint port
OPCUA_HOST=                           # hostname advertised in discovery URLs; unset ⇒ HOSTNAME, else localhost
# PLANT_CONFIG / PKI_DIR are shared with the backend above.

# ── Logging (read by the tracing subscriber, not the config structs) ─────────
RUST_LOG=info
