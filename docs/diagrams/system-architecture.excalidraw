    {
      "id": "backend-body",
      "type": "text",
      "x": 76,
      "y": 204,
      "width": 248,
      "height": 176,
      "text": "·  OPC-UA browse + read + write\n·  Jacobi orchestration tick\n·  k8s reconciler (kubectl)\n·  Postgres LISTEN loop\n·  CRUD REST API\n·  WebSocket live stream\n·  Asset store (GET /assets/{id})\n·  Setpoint write (POST /setpoint)",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roughness": 0
    },
