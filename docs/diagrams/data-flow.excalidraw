    {
      "id": "jacobi-box",
      "type": "rectangle",
      "x": 40,
      "y": 450,
      "width": 420,
      "height": 120,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ebfbee",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "roughness": 0,
      "opacity": 100,
      "roundness": { "type": 3 }
    },
    {
      "id": "jacobi-txt",
      "type": "text",
      "x": 56,
      "y": 460,
      "width": 388,
      "height": 100,
      "text": "Jacobi semantics — why it matters:\n· Every device reads LAST tick's inputs (frozen snapshot).\n· A value travels one hop per tick → chain latency = depth × tick.\n· Parallel branches off one source update on the same tick.\n· Feedback loops iterate tick-by-tick (no cycle rejection).\n· Devices with unwired inputs stay idle (readiness gate).",
      "fontSize": 12,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "roughness": 0
    }
  ],
  "appState": {
    "viewBackgroundColor": "#ffffff",
    "gridSize": 20
  }
}
